{
  "name": "especial-cacamba-dos-cria",
  "productName": "Especial Caçamba dos Cria",
  "version": "1.0.13",
  "description": "Chamada de voz, compartilhamento de tela e soundboard só para os cria.",
  "main": "main.js",
  "author": "Vitor Freire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vm-freire/especial-cacamba-dos-cria.git"
  },
  "scripts": {
    "build:renderer": "esbuild src/app.js --bundle --format=esm --target=chrome120 --outfile=dist/app.js --minify --sourcemap && esbuild src/main/ytsearch.mjs --bundle --platform=node --format=cjs --target=node22 --outfile=dist/ytsearch.cjs --minify && esbuild src/main/vozes.mjs --bundle --platform=node --format=cjs --target=node22 --outfile=dist/vozes.cjs && node build/copy-rnnoise.cjs",
    "start": "npm run build:renderer && electron .",
    "estudio": "electron estudio",
    "dist": "npm run build:renderer && electron-builder --win --publish never",
    "release": "npm run build:renderer && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.cacambadoscria.app",
    "productName": "Especial Caçamba dos Cria",
    "artifactName": "Especial-Cacamba-dos-Cria-Setup.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "bot-preload.js",
      "src/index.html",
      "src/styles.css",
      "src/grupo.jpg",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Especial Caçamba dos Cria",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "vm-freire",
        "repo": "especial-cacamba-dos-cria",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@sapphi-red/web-noise-suppressor": "0.3.5",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "firebase": "^13.4.0",
    "youtubei.js": "^18.3.0"
  }
}
